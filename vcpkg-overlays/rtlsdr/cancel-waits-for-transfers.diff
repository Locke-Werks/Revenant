@@ -97,6 +100,8 @@ struct rtlsdr_dev {
 	void *cb_ctx;
 	enum rtlsdr_async_status async_status;
 	int async_cancel;
+	/* transfers submitted and not yet handed back by libusb */
+	int xfer_in_flight;
 	int use_zerocopy;
 	/* rtl demod context */
 	uint32_t rate; /* Hz */
@@ -1726,8 +1731,14 @@ static void LIBUSB_CALL _libusb_callback(struct libusb_transfer *xfer)
 		if (dev->cb)
 			dev->cb(xfer->buffer, xfer->actual_length, dev->cb_ctx);
 
-		libusb_submit_transfer(xfer); /* resubmit transfer */
 		dev->xfer_errors = 0;
+
+		/* resubmit only while streaming: once a cancel has been
+		 * asked for, a completed transfer stays home, so the set
+		 * rtlsdr_read_async has to wait for only ever shrinks */
+		if (RTLSDR_RUNNING == dev->async_status &&
+		    libusb_submit_transfer(xfer) == 0)
+			return;
 	} else if (LIBUSB_TRANSFER_CANCELLED != xfer->status) {
 #ifndef _WIN32
 		if (LIBUSB_TRANSFER_ERROR == xfer->status)
@@ -1743,6 +1754,10 @@ static void LIBUSB_CALL _libusb_callback(struct libusb_transfer *xfer)
 		}
 #endif
 	}
+
+	/* libusb has handed this transfer back and nobody resubmitted
+	 * it, so it is no longer in flight and may be freed */
+	dev->xfer_in_flight--;
 }
 
 int rtlsdr_wait_async(rtlsdr_dev_t *dev, rtlsdr_read_async_cb_t cb, void *ctx)
@@ -1874,7 +1889,6 @@ int rtlsdr_read_async(rtlsdr_dev_t *dev, rtlsdr_read_async_cb_t cb, void *ctx,
 	unsigned int i;
 	int r = 0;
 	struct timeval tv = { 1, 0 };
-	struct timeval zerotv = { 0, 0 };
 	enum rtlsdr_async_status next_status = RTLSDR_INACTIVE;
 
 	if (!dev)
@@ -1900,6 +1914,7 @@ int rtlsdr_read_async(rtlsdr_dev_t *dev, rtlsdr_read_async_cb_t cb, void *ctx,
 		dev->xfer_buf_len = DEFAULT_BUF_LENGTH;
 
 	_rtlsdr_alloc_async_buffers(dev);
+	dev->xfer_in_flight = 0;
 
 	for(i = 0; i < dev->xfer_buf_num; ++i) {
 		libusb_fill_bulk_transfer(dev->xfer[i],
@@ -1911,8 +1926,12 @@ int rtlsdr_read_async(rtlsdr_dev_t *dev, rtlsdr_read_async_cb_t cb, void *ctx,
 					  (void *)dev,
 					  BULK_TIMEOUT);
 
+		/* counted before the submit, because its callback can run
+		 * on another thread before libusb_submit_transfer returns */
+		dev->xfer_in_flight++;
 		r = libusb_submit_transfer(dev->xfer[i]);
 		if (r < 0) {
+			dev->xfer_in_flight--;
 			fprintf(stderr, "Failed to submit transfer %i\n"
 					"Please increase your allowed " 
 					"usbfs buffer size with the "
@@ -1945,39 +1964,51 @@ int rtlsdr_read_async(rtlsdr_dev_t *dev, rtlsdr_read_async_cb_t cb, void *ctx,
 			if (!dev->xfer)
 				break;
 
-			for(i = 0; i < dev->xfer_buf_num; ++i) {
-				if (!dev->xfer[i])
-					continue;
-
-				if (LIBUSB_TRANSFER_CANCELLED !=
-						dev->xfer[i]->status) {
-					r = libusb_cancel_transfer(dev->xfer[i]);
-					/* handle events after canceling
-					 * to allow transfer status to
-					 * propagate */
-#ifdef _WIN32
-					Sleep(1);
-#endif
-					libusb_handle_events_timeout_completed(dev->ctx,
-									       &zerotv, NULL);
-					if (r < 0)
-						continue;
-
-					next_status = RTLSDR_CANCELING;
+			/* Wait for libusb to hand back every transfer before
+			 * freeing any of them. This loop used to return on the
+			 * first pass in which no libusb_cancel_transfer call
+			 * succeeded, but a transfer libusb is already
+			 * cancelling answers LIBUSB_ERROR_NOT_FOUND until its
+			 * completion has been handled, so that pass could come
+			 * while transfers were still in flight. They were
+			 * freed, read_async returned -5, and libusb later
+			 * wrote to the freed memory.
+			 *
+			 * The cancels are repeated on every pass because
+			 * repeating one is harmless, NOT_FOUND again, and
+			 * because a transfer resubmitted by a callback that
+			 * ran on another thread before the cancel was asked
+			 * for would otherwise wait for data that may not
+			 * come. */
+			while (dev->xfer_in_flight > 0) {
+				for(i = 0; i < dev->xfer_buf_num; ++i) {
+					if (dev->xfer[i])
+						libusb_cancel_transfer(dev->xfer[i]);
 				}
-			}
 
-			if (dev->dev_lost || RTLSDR_INACTIVE == next_status) {
-				/* handle any events that still need to
-				 * be handled before exiting after we
-				 * just cancelled all transfers */
-				libusb_handle_events_timeout_completed(dev->ctx,
-								       &zerotv, NULL);
-				break;
+				r = libusb_handle_events_timeout_completed(dev->ctx,
+									   &tv, NULL);
+				if (r < 0 && r != LIBUSB_ERROR_INTERRUPTED)
+					break;
+				r = 0;
 			}
+			break;
 		}
 	}
 
+	if (dev->xfer_in_flight > 0) {
+		/* only when libusb's event handling itself failed: these
+		 * transfers still belong to libusb, and freeing them is the
+		 * use after free the loop above exists to prevent, so they
+		 * are leaked instead */
+		fprintf(stderr, "%d transfers still in flight after "
+			"handle_events returned %d, not freeing them\n",
+			dev->xfer_in_flight, r);
+		dev->xfer = NULL;
+		dev->xfer_buf = NULL;
+		dev->xfer_in_flight = 0;
+	}
+
 	_rtlsdr_free_async_buffers(dev);
 
 	dev->async_status = next_status;
