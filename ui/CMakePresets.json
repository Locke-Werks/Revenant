{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/build/${presetName}/install",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_HOST_TRIPLET": "x64-windows",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL",
        "CMAKE_PREFIX_PATH": "C:/Qt/6.8.3/msvc2022_64",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "vs",
      "displayName": "Visual Studio x64, dynamic CRT",
      "description": "Works from any shell. No vcvars needed. Use this if in doubt. The generator is deliberately unpinned so a newer Visual Studio does not break the preset.",
      "inherits": "base",
      "architecture": "x64"
    },
    {
      "name": "ninja",
      "displayName": "Ninja RelWithDebInfo, dynamic CRT",
      "description": "Requires an x64 Native Tools prompt. Console output from a failed connect is visible here, which the vs preset's launcher hides.",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "ninja-debug",
      "displayName": "Ninja Debug, dynamic debug CRT",
      "description": "Links Qt6Cored and friends. Requires an x64 Native Tools prompt.",
      "inherits": "ninja",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    }
  ],
  "buildPresets": [
    { "name": "vs", "configurePreset": "vs", "configuration": "RelWithDebInfo" },
    { "name": "ninja", "configurePreset": "ninja" },
    { "name": "ninja-debug", "configurePreset": "ninja-debug" }
  ]
}
